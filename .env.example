# PostgreSQL
POSTGRES_DB=url_shortener
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Spring Boot
SERVER_PORT=8080

# Database (Should match PostgreSQL variables above)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener
DB_USERNAME=your_postgres_user
DB_PASSWORD=your_postgres_password

# Keycloak Base Configuration
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=Realm_Name
KEYCLOAK_CLIENT_ID=url-shortener-client
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# ADMIN LOGIN
# These credentials are used ONLY for logging into the Keycloak Admin UI on port 8081.
KEYCLOAK_ADMIN=your_keycloak_admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# ADMIN USER
# These credentials represent a user created within Keycloak with high privileges,
# used by the application for managing resources.
KEYCLOAK_ADMIN_USER=your_app_admin_username
KEYCLOAK_ADMIN_USER_PASSWORD=your_app_admin_password

# Application Settings
BASE_URL=http://localhost:8080
DEFAULT_EXPIRATION_DAYS=x # insert number 
SHORT_CODE_LENGTH=x # insert number

# Logging
LOG_LEVEL=INFO
